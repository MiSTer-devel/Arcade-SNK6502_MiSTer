<misterromdescription>
    <name>Satan Of Saturn</name>
    <setname>satansat</setname>
    <rbf>SNK6502</rbf>
    <mameversion>0261</mameversion>
    <year>1980</year>
    <manufacturer>SNK</manufacturer>
    <players>1</players>
    <joystick>2-way</joystick>
    <rotation>vertical (cw)</rotation>
    <region>World</region>
    <category>Shooter</category>

    <rom index="0" zip="satansat.zip" md5="none">

        <!-- maincpu: 64KB at offset $00000 -->
        <!-- $0000-$3FFF: padding (16KB) -->
        <part repeat="0x4000">00</part>

        <!-- $4000: ss1 (2KB) -->
        <part name="ss1" crc="549dd13a"/>
        <!-- $4800: ss2 (2KB) -->
        <part name="ss2" crc="04972fa8"/>
        <!-- $5000: ss3 (2KB) -->
        <part name="ss3" crc="9caf9057"/>
        <!-- $5800: ss4 (2KB) -->
        <part name="ss4" crc="e1bdcfe1"/>
        <!-- $6000: ss5 (2KB) -->
        <part name="ss5" crc="d454de19"/>
        <!-- $6800: ss6 (2KB) -->
        <part name="ss6" crc="7fbd5d30"/>
        <!-- $7000: zarz128.15 (2KB) -->
        <part name="zarz128.15" crc="93ea2df9"/>
        <!-- $7800: zarz129.16 (2KB) -->
        <part name="zarz129.16" crc="e67ec873"/>

        <!-- $8000: zarz130.22 (2KB) -->
        <part name="zarz130.22" crc="22c44650"/>
        <!-- $8800: ss10 (2KB) -->
        <part name="ss10" crc="8f1b313a"/>
        <!-- $9000: ss11 (2KB) -->
        <part name="ss11" crc="e74f98e0"/>

        <!-- $F800: zarz129.16 mirror for reset/interrupt vectors -->
        <part name="zarz129.16" crc="e67ec873"/>

        <!-- gfx1: 4KB at offset $10000 -->
        <!-- plane 0: zarz135.73 (2KB)  -->
        <part name="zarz135.73" crc="e837c62b"/>
        <!-- plane 1: zarz136.75 (2KB)  -->
        <part name="zarz136.75" crc="83f61623"/>
        <part repeat="0x1000">00</part>

        <!-- proms: 32 bytes at offset $12000 (only one PROM for sasuke) -->
        <part name="zarz138.03" crc="5dd6933a"/>
        <!-- pad to 64 bytes -->
        <part repeat="0x0020">00</part>

        <!-- sound ROMs at offset $12040 -->
        <part name="ss12" crc="dee01f24"/>
        <part name="zarz134.54" crc="580934d2"/>

    </rom>

    <!-- ROM index 1: game_id = 1 (GID_SATANSAT) -->
    <rom index="1">
        <part>01</part>
    </rom>

</misterromdescription>
