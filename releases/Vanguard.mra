<misterromdescription>
    <n>Vanguard</n>
    <setname>vanguard</setname>
    <rbf>SNK6502</rbf>
    <mameversion>0261</mameversion>
    <year>1981</year>
    <manufacturer>SNK</manufacturer>
    <players>1</players>
    <joystick>4-way</joystick>
    <rotation>vertical (cw)</rotation>
    <region>World</region>
    <category>Shooter</category>

    <!-- MRA-DIPS-2026-08-03: DIP switches read at $3106. From MAME snk6502.cpp INPUT_PORTS_START(
         snk6502_generic_joy8way) "DSW" - vanguard does not PORT_MODIFY it.
         MAME defaults: Cabinet=0x01 (Upright), Coinage=0x02 (2C/1C),
         Lives=0x00 (3), Coinage Bonus=0x00  =>  default byte 0x03.
         Previously this block was EMPTY with default="00", which reads back as
         0x00 = COCKTAIL cabinet + wrong coinage. -->
    <switches default="03" base="16">
        <dip name="Cabinet" bits="0" ids="Cocktail,Upright"/>
        <dip name="Coinage" bits="1,3" ids="1C/1C,2C/1C,1C/3C,1C/1C,1C/2C,1C/1C,1C/6C,1C/1C"/>
        <dip name="Lives" bits="4,5" ids="3,4,5,3"/>
        <dip name="Coinage Bonus" bits="6" ids="1C/1C,2C/1C"/>
        <dip name="Unused" bits="7" ids="Off,On"/>
    </switches>

    <buttons names="Fire Right,Fire Down,Fire Up,Fire Left,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <rom index="0" zip="vanguard.zip" md5="none">

        <!-- maincpu: 64KB at offset $00000 -->
        <!-- $0000-$3FFF: padding (16KB) -->
        <part repeat="0x4000">00</part>

        <!-- $4000: ic07 (4KB) -->
        <part name="sk4_ic07.bin" crc="6a29e354"/>

        <!-- $5000: ic08 (4KB) -->
        <part name="sk4_ic08.bin" crc="302bba54"/>

        <!-- $6000: ic09 (4KB) -->
        <part name="sk4_ic09.bin" crc="424755f6"/>

        <!-- $7000: ic10 (4KB) -->
        <part name="sk4_ic10.bin" crc="54603274"/>

        <!-- $8000: ic13 (4KB) -->
        <part name="sk4_ic13.bin" crc="fde157d0"/>

        <!-- $9000: ic14 (4KB) -->
        <part name="sk4_ic14.bin" crc="0d5b47d0"/>

        <!-- $A000: ic15 (4KB) -->
        <part name="sk4_ic15.bin" crc="8549b8f8"/>

        <!-- $B000: ic16 (4KB) -->
        <part name="sk4_ic16.bin" crc="062e0be2"/>

        <!-- $C000-$EFFF: padding (12KB) -->
        <part repeat="0x3000">00</part>

        <!-- $F000: ic13 again (mirror for reset/interrupt vectors) -->
        <part name="sk4_ic13.bin" crc="fde157d0"/>

        <!-- gfx1: 4KB at offset $10000 (Vanguard is small GFX) -->
        <!-- plane 0: ic50 (2KB) padded to 4KB -->
        <part name="sk5_ic50.bin" crc="e7d4315b"/>
        <part repeat="0x0800">00</part>
        <!-- plane 1: ic51 (2KB) padded to 4KB -->
        <part name="sk5_ic51.bin" crc="96e87858"/>
        <part repeat="0x0800">00</part>

        <!-- proms: 64 bytes at offset $12000 -->
        <part name="sk5_ic7.bin" crc="ad782a73"/>
        <part name="sk5_ic6.bin" crc="7dc9d450"/>

