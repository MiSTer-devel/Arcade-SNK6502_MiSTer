        <!-- padding to $14000 -->
        <part repeat="0xFC0">00</part>

        <!-- speech ROMs (HD38880 PARCOR data, SK6 board): 6KB at offset $14000 -->
        <part name="sk6_ic07.bin"/>
        <part name="sk6_ic08.bin"/>
        <part name="sk6_ic11.bin"/>

    </rom>

    <!-- ROM index 1: game_id = 2 (GID_VANGUARD) -->
    <rom index="1">
        <part>02</part>
    </rom>

</misterromdescription>